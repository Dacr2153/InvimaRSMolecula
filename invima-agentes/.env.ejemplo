# Copia este archivo a .env y pega tu key.
# .env esta en .gitignore: la key nunca debe llegar al repositorio.
#
# La key se crea en https://aistudio.google.com/apikey
# IMPORTANTE: al crearla, selecciona el proyecto de Google Cloud que esta
# vinculado a la cuenta de facturacion del evento. Una key creada sin proyecto
# corre en capa gratuita y NO consume el credito.

GEMINI_API_KEY=

# Opcional. Por defecto gemini-flash-latest.
# Lista los disponibles con: invima-a1 modelos
INVIMA_MODELO=gemini-flash-latest
